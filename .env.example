PORT=8000
NODE_ENV=development

# Database Configuration (PostgreSQL / Aiven)
DB_URL=postgres://user:password@host:port/defaultdb?sslmode=require
DATABASE_URL=postgres://user:password@host:port/defaultdb?sslmode=require

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Pinecone Vector DB Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=company-policies
PINECONE_ENVIRONMENT=
